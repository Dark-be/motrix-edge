# Copy this file to .env. Uncomment only values that differ from the defaults.

# Docker Compose: host directory mounted at /root/workspace.
# Relative paths resolve from the Compose project directory.
# MOTRIX_EDGE_WORKSPACE_DIR=.

# Docker Compose: runtime roots inside the container.
# MOTRIX_EDGE_DIR_IN_CONTAINER=/root/workspace/motrix-edge
# MOTRIX_ROBOT_PIPELINE_DIR_IN_CONTAINER=/root/workspace/robot-pipeline/motrix-robot-pipeline

# Host/bare-metal runtime roots. Compose does not pass these host paths through.
# MOTRIX_EDGE_DIR=/absolute/path/to/motrix-edge
# MOTRIX_ROBOT_PIPELINE_DIR=/absolute/path/to/motrix-robot-pipeline

# Write application and HTTP logs to each runtime root's logs/ directory.
# MOTRIX_EDGE_LOG_FILE=0
